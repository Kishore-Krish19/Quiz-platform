# Server and Environment Configuration
PORT=3000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/gadget_code
CLIENT_URL=http://localhost:3000

# JWT_SECRET: leave empty. On first start the server generates a random secret for this
# install and keeps it in data/.jwt-secret (git-ignored). If you set one yourself, use at
# least 32 random characters — a short or published secret is refused at startup.
JWT_SECRET=

# ADMIN_PASSWORD: required on a fresh install (at least 10 characters). It becomes the
# password of the "admin" account, and replaces the old published default on existing
# installs. Change it any time under Settings in the admin console; putting a NEW value
# here and restarting resets it — the way back in if it is forgotten.
ADMIN_PASSWORD=

# GEMINI_API_KEY: Required for Gemini AI API calls if enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
