{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "stress:setup": "tsx stress-test/setup.ts",
    "stress:cleanup": "tsx stress-test/cleanup.ts",
    "stress:10": "tsx stress-test/run-stress-test.ts --players 10",
    "stress:25": "tsx stress-test/run-stress-test.ts --players 25",
    "stress:40": "tsx stress-test/run-stress-test.ts --players 40",
    "stress:50": "tsx stress-test/run-stress-test.ts --players 50",
    "stress:75": "tsx stress-test/run-stress-test.ts --players 75",
    "stress:100": "tsx stress-test/run-stress-test.ts --players 100",
    "stress:ramp": "tsx stress-test/run-stress-test.ts --ramp",
    "stress:all": "tsx stress-test/run-stress-test.ts --all",
    "stress:help": "tsx stress-test/run-stress-test.ts --help"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "bcryptjs": "^3.0.3",
    "canvas-confetti": "^1.9.4",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "mongoose": "^9.9.4",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "vite": "^6.2.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
